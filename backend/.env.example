# ==========================================
# SGIP BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sgip?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/sgip?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=sgip_super_secret_jwt_key_2026

# Groq AI API Key (For Dynamic Assessment & AI Milestones)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend Application URL for CORS
FRONTEND_URL=http://localhost:5173

# SMTP Email Service (Optional for OTP / Password Reset)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
